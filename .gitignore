# =============================================================================
# Altrex ERP — root .gitignore
# Covers all workspaces: apps/admin, apps/erp, packages/ui, packages/api-client,
# packages/config. No per-package .gitignore files needed.
# =============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# ── Next.js ───────────────────────────────────────────────────────────────────
**/.next/
**/out/

# ── Build output ──────────────────────────────────────────────────────────────
**/build/
**/dist/

# ── TypeScript ────────────────────────────────────────────────────────────────
**/*.tsbuildinfo
**/next-env.d.ts

# ── Environment files ─────────────────────────────────────────────────────────
# Commit .env.example; never commit real secrets
.env
.env.*
!.env.example
!**/.env.example

# ── Testing & coverage ────────────────────────────────────────────────────────
**/coverage/

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Deployment ────────────────────────────────────────────────────────────────
.vercel

# ── Misc dev artifacts ────────────────────────────────────────────────────────
repomix-output.json
